{
  "name": "AutoMLens Design Tokens",
  "version": "1.0.0",
  "font": {
    "sans": "Geist Sans, ui-sans-serif, system-ui, sans-serif",
    "mono": "Geist Mono, ui-monospace, SFMono-Regular, monospace",
    "roles": {
      "sans": ["headings", "body", "navigation", "forms", "buttons", "tables", "dialogs"],
      "mono": ["metrics", "numeric table columns", "timestamps", "IDs", "hashes", "code", "technical configuration", "logs"]
    },
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "scale": {
      "display-xl": {"fontSize": "36px", "lineHeight": "42px", "fontWeight": 600, "letterSpacing": "-0.045em"},
      "page-title": {"fontSize": "28px", "lineHeight": "34px", "fontWeight": 600, "letterSpacing": "-0.035em"},
      "page-title-compact": {"fontSize": "24px", "lineHeight": "30px", "fontWeight": 600, "letterSpacing": "-0.03em"},
      "section-title": {"fontSize": "16px", "lineHeight": "22px", "fontWeight": 600, "letterSpacing": "-0.02em"},
      "card-title": {"fontSize": "14px", "lineHeight": "20px", "fontWeight": 600, "letterSpacing": "-0.01em"},
      "body": {"fontSize": "14px", "lineHeight": "21px", "fontWeight": 400, "letterSpacing": "-0.005em"},
      "body-strong": {"fontSize": "14px", "lineHeight": "21px", "fontWeight": 550, "letterSpacing": "-0.005em"},
      "body-small": {"fontSize": "13px", "lineHeight": "19px", "fontWeight": 400, "letterSpacing": "0"},
      "table": {"fontSize": "13px", "lineHeight": "18px", "fontWeight": 400, "letterSpacing": "0"},
      "label": {"fontSize": "12px", "lineHeight": "16px", "fontWeight": 500, "letterSpacing": "0"},
      "caption": {"fontSize": "11px", "lineHeight": "16px", "fontWeight": 500, "letterSpacing": "0.005em"},
      "metric-lg": {"fontSize": "26px", "lineHeight": "30px", "fontWeight": 550, "letterSpacing": "-0.025em"},
      "metric-md": {"fontSize": "20px", "lineHeight": "24px", "fontWeight": 550, "letterSpacing": "-0.02em"},
      "mono-data": {"fontSize": "13px", "lineHeight": "18px", "fontWeight": 450, "letterSpacing": "0", "fontVariantNumeric": "tabular-nums", "fontFeatureSettings": "'tnum' 1"},
      "mono-code": {"fontSize": "12px", "lineHeight": "18px", "fontWeight": 400, "letterSpacing": "0"}
    }
  },
  "spacing": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px"
  },
  "radius": {
    "input": "8px",
    "button": "8px",
    "card": "10px",
    "dialog": "12px",
    "popover": "12px",
    "pill": "999px"
  },
  "layout": {
    "sidebarExpanded": "232px",
    "sidebarCollapsed": "64px",
    "headerHeight": "60px",
    "pagePaddingDesktop": "28px",
    "pagePaddingMedium": "20px",
    "pagePaddingMobile": "16px",
    "cardPadding": "16px",
    "analyticsPanelPadding": "20px",
    "sectionGap": "32px",
    "cardGap": "16px",
    "controlHeight": "36px",
    "compactControlHeight": "32px",
    "tableHeaderHeight": "40px",
    "tableRowHeight": "40px",
    "tableRowHeightCompact": "36px"
  },
  "themes": {
    "light": {
      "canvas": "#F8FAFC",
      "surface": "#FFFFFF",
      "surfaceSubtle": "#F1F5F9",
      "surfaceHover": "#E2E8F0",
      "border": "#E2E8F0",
      "borderStrong": "#CBD5E1",
      "textPrimary": "#0F172A",
      "textSecondary": "#475569",
      "textMuted": "#64748B",
      "textSubtle": "#94A3B8",
      "accent": "#2563EB",
      "accentHover": "#1D4ED8",
      "success": "#059669",
      "warning": "#B45309",
      "danger": "#DC2626",
      "info": "#0369A1"
    },
    "dark": {
      "canvas": "#090A0F",
      "surface": "#111318",
      "surfaceSubtle": "#181B22",
      "surfaceHover": "#222630",
      "border": "#252A34",
      "borderSubtle": "rgba(255,255,255,0.08)",
      "borderStrong": "rgba(255,255,255,0.14)",
      "textPrimary": "#F8FAFC",
      "textSecondary": "#CBD5E1",
      "textMuted": "#94A3B8",
      "textSubtle": "#64748B",
      "accent": "#3B82F6",
      "accentHover": "#60A5FA",
      "success": "#34D399",
      "warning": "#FBBF24",
      "danger": "#F87171",
      "info": "#38BDF8"
    }
  },
  "motion": {
    "fast": "120ms",
    "standard": "160ms",
    "slow": "180ms",
    "easingEnter": "cubic-bezier(0, 0, 0.2, 1)",
    "easingExit": "cubic-bezier(0.4, 0, 1, 1)",
    "respectReducedMotion": true
  },
  "principles": [
    "No ambient purple/pink gradients or blurred glow blobs",
    "No routine card shadows; use 1px borders and surface contrast",
    "Use semantic color only for meaningful state",
    "Use tabular numerals for score columns, metrics, timestamps, and counts",
    "Light, Dark, and System themes must all work",
    "Do not fabricate product data or interaction states"
  ]
}
