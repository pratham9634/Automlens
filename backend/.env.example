# Environment
AUTOMLENS_ENV=development

# Database Connection (Docker PostgreSQL default)
# Format: postgresql+psycopg://username:password@host:port/database
DATABASE_URL=postgresql+psycopg://postgres:postgrespassword@localhost:5433/automlens

# Fallback test SQLite if PostgreSQL is unreachable
AUTOMLENS_ALLOW_SQLITE_FALLBACK=true

# Parallel Workers for CPU training (caps concurrent processes)
AUTOMLENS_MAX_WORKERS=4

# Storage Paths
AUTOMLENS_ARTIFACT_DIR=./artifacts

# Dataset Limits
AUTOMLENS_MAX_UPLOAD_MB=50
AUTOMLENS_MAX_ROWS=100000
AUTOMLENS_MAX_COLUMNS=200

# CORS
AUTOMLENS_CORS_ORIGINS=http://localhost:3000

# Logging
AUTOMLENS_LOG_LEVEL=INFO

# AI Decision Engine via OpenRouter (Optional: offline fallback works without this)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
